{
  "manifest_version": 3,
  "name": "YT Stealth Blocker",
  "version": "1.0",
  "description": "Recruiter-ready DOM observer and element blocker.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "idle"
  ],
  "host_permissions": [
    "*://suggestqueries.google.com/*",
    "http://localhost/*",
    "https://youtube-blocker-extention.onrender.com/*",
    "https://youtube-blocker-extention-frontend.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "react-popup/dist/index.html"
  },
  "options_page": "react-popup/dist/index.html",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["focus.css"]
    }
  ]
}